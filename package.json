{
  "name": "dsh-vault",
  "version": "0.3.0",
  "private": true,
  "description": "Back up your DSH skills, memory and MCP configs into private Git repositories — daily or on demand.",
  "type": "module",
  "license": "MIT",
  "author": "faintspire",
  "homepage": "https://github.com/faintspire/dsh-vault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faintspire/dsh-vault.git"
  },
  "bugs": {
    "url": "https://github.com/faintspire/dsh-vault/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skill",
    "memory",
    "mcp",
    "git",
    "backup"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dsh-vault": "./index.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "vault.example.json",
    "scripts/",
    "test/"
  ],
  "scripts": {
    "test": "node test/verify.mjs",
    "install-plugin": "node scripts/install.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
